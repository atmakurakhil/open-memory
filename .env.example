# open-memory reads everything from the environment. Copy to .env and fill in only what you use.

# Where your memory lives (one SQLite file).
OPEN_MEMORY_DB=~/.open-memory/memory.db

# Embeddings. Default runs locally through Ollama (`ollama pull nomic-embed-text`), no key.
# Alternatives: fastembed:BAAI/bge-small-en-v1.5 (no server), hash (tests only).
OPEN_MEMORY_EMBEDDER=ollama:nomic-embed-text

# Optional LLM for `ask` and fact extraction: provider:model. Leave empty to run with no LLM at all.
# Providers: openai, anthropic, gemini, groq, openrouter, together, deepseek, ollama (local, no key).
OPEN_MEMORY_LLM=

# Your own key for whichever provider you picked above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
